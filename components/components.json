{
  "$schema_note": "Specs de componente AGLAYA — fuente canónica que el MCP aglaya-ds lee en vivo (list_components/get_component). Los colores citan tokens de colors_and_type.css (consume, no copies); los literales estructurales (padding, tamaños, tracking) son la spec. El render de referencia vive en preview/. No-negociables aplican: radius 0, sin emoji, tipos Outfit/Inter/Space Mono.",
  "components": [
    {
      "id": "button",
      "name": "Button",
      "specimen": "preview/components-buttons.html",
      "tokens": ["--color-brand", "--color-text", "--color-border-strong", "--color-muted", "--font-display", "--font-mono"],
      "variants": [
        {
          "name": "primary",
          "use": "La ÚNICA llamada a la acción fuerte. Roja.",
          "spec": {
            "background": "var(--color-brand)",
            "color": "var(--color-text)",
            "border": "none",
            "padding": "18px 22px",
            "font": "var(--font-display) 900 13px",
            "letter-spacing": "0.2em",
            "text-transform": "uppercase",
            "radius": "0",
            "signature": "sombra dura desplazada: pseudo-caja con border 1px var(--color-border-strong), transform translate(4px,4px), z-index -1",
            "label_convention": "termina en flecha literal ' →' (no icono)"
          }
        },
        {
          "name": "ghost",
          "use": "Acción secundaria. Translúcida, sin relleno de marca.",
          "spec": {
            "background": "rgba(255,255,255,0.1)",
            "color": "var(--color-text)",
            "border": "1px solid var(--color-border-strong)",
            "padding": "12px 20px",
            "font": "var(--font-display) 900 11px",
            "letter-spacing": "0.2em",
            "text-transform": "uppercase",
            "radius": "0"
          }
        },
        {
          "name": "link",
          "use": "Acción terciaria / navegación textual. Mono, con regla horizontal.",
          "spec": {
            "font": "var(--font-mono) 10px",
            "letter-spacing": "0.3em",
            "text-transform": "uppercase",
            "color": "var(--color-muted)",
            "adornment": "regla 40px×1px rgba(255,255,255,0.2) tras el texto"
          }
        }
      ],
      "rules": [
        "Radius 0 en todas las variantes.",
        "Label SIEMPRE UPPERCASE, tracking ancho (0.2em–0.3em).",
        "Una sola primary (roja) por vista — es la señal, no decoración.",
        "La flecha es el carácter '→' literal, nunca un icono de librería."
      ]
    },
    {
      "id": "card",
      "name": "Card",
      "specimen": "preview/components-card.html",
      "tokens": ["--color-surface-2", "--color-corporate-green", "--color-brand", "--color-text", "--color-muted", "--color-border-brand", "--font-display", "--font-body", "--font-mono"],
      "spec": {
        "background": "var(--color-surface-2)",
        "border": "1px solid rgba(255,255,255,0.05)",
        "padding": "28px",
        "index_eyebrow": "var(--font-mono) 9px, tracking 0.4em, uppercase, var(--color-corporate-green) @0.7 (ej: LOGIC_NODE_001)",
        "dot": "6px×6px var(--color-brand), esquina superior derecha",
        "title": "var(--font-display) 900 22px, tracking -0.02em, uppercase, var(--color-text)",
        "body": "var(--font-body) 13px, line-height 1.55, var(--color-muted)",
        "rule": "32px×1px rgba(255,255,255,0.1) al pie",
        "radius": "0"
      },
      "states": {
        "hover": "border → var(--color-border-brand); la regla al pie crece a 100% y pasa a rgba(232,0,61,0.2); el título pasa a var(--color-brand)"
      },
      "rules": ["Radius 0.", "Eyebrow de índice en mono verde + punto rojo: la firma de tarjeta AGLAYA.", "Profundidad por superficie (surface-2), nunca por sombra difusa."]
    },
    {
      "id": "input",
      "name": "Input / Field",
      "specimen": "preview/components-inputs.html",
      "tokens": ["--color-corporate-green", "--color-brand", "--color-text", "--font-body", "--font-mono"],
      "spec": {
        "background": "rgba(255,255,255,0.03)",
        "border": "1px solid rgba(255,255,255,0.35)",
        "padding": "14px 16px",
        "font": "var(--font-body) 13px",
        "color": "rgba(255,255,255,0.5)",
        "textarea": "misma caja, min-height 56px",
        "label": "var(--font-mono) 9px, tracking 0.3em, uppercase, var(--color-corporate-green), margin-bottom 4px",
        "radius": "0"
      },
      "states": {
        "focus": "border → rgba(232,0,61,0.5); background → rgba(232,0,61,0.03); color → var(--color-text); outline 2px solid rgba(232,0,61,0.9) con outline-offset 2px"
      },
      "rules": ["Radius 0.", "Borde de reposo más fuerte de lo normal (0.35) — el campo debe verse.", "Foco = anillo rojo de marca (accesible), no glow difuso.", "Label = eyebrow mono verde, como en card."]
    },
    {
      "id": "badge",
      "name": "Badge / Pill",
      "specimen": "preview/components-badges.html",
      "tokens": ["--color-corporate-green", "--color-brand", "--color-text", "--font-mono"],
      "variants": [
        {"name": "default", "spec": {"font": "var(--font-mono) 10px", "letter-spacing": "0.25em", "text-transform": "uppercase", "padding": "6px 12px", "border": "1px solid rgba(255,255,255,0.1)", "background": "rgba(255,255,255,0.05)", "color": "rgba(255,255,255,0.6)"}},
        {"name": "brand", "spec": {"color": "var(--color-corporate-green)", "border": "1px solid rgba(232,0,61,0.2)", "background": "rgba(232,0,61,0.1)"}},
        {"name": "codetag", "spec": {"background": "var(--color-text)", "color": "#000", "border": "transparent", "letter-spacing": "0.18em"}},
        {"name": "ok", "spec": {"color": "var(--color-corporate-green)", "border": "1px solid rgba(159,194,67,0.3)"}},
        {"name": "pill", "spec": {"font": "var(--font-mono) 9px", "letter-spacing": "0.3em", "adornment": "punto 6px var(--color-brand) que pulsa (opacity 0.4↔1, 1.5s)"}}
      ],
      "rules": ["Radius 0 (pill NO es redonda — es rectángulo mono).", "Space Mono uppercase, tracking ancho.", "Verde corporativo para estado/etiqueta; rojo solo como señal puntual (punto que pulsa)."]
    }
  ]
}
